{
  "name": "reels-downloader",
  "version": "1.0.0",
  "description": "Микросервис для скачивания рилсов и отправки в Telegram",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.cjs",
    "dev": "nodemon",
    "build": "swc src -d dist",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.100",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "reels",
    "downloader",
    "telegram",
    "bot",
    "yt-dlp"
  ],
  "author": "",
  "license": "MIT"
}
